# Copy to .env and fill in. NEVER commit .env. Blank values mean "unset".
# Full reference: backend/app/core/config.py and docs/ARCHITECTURE.md section 12.

# ---------- App ----------
APP_ENV=development
# Signs applicant session tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=
APP_TIMEZONE=Asia/Kolkata
FRONTEND_ORIGIN=http://localhost:5173

# ---------- Models 1 & 2 (same provider + model for both) ----------
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Low-cost default as of 2026-11-20. VERIFY the exact id on OpenAI's models page before the first run.
# gpt-5-mini / gpt-5-nano are retired from the API on 2026-12-11 - do not use them.
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional provider for Models 1 & 2 together (never an automatic fallback). Small balance: use sparingly.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=800
# Leave blank unless the model supports them (reasoning models reject temperature).
LLM_TEMPERATURE=
LLM_REASONING_EFFORT=
HISTORY_TURNS=6

# ---------- Model 3: OpenAI-compatible endpoint (vLLM) serving the LoRA adapter ----------
# Model 3 stays "Not configured" (HTTP 503) until ALL four of these are set.
MODEL3_BASE_URL=
MODEL3_API_KEY=
MODEL3_MODEL=
MODEL3_BASE_MODEL_ID=
MODEL3_ADAPTER_ID=
# Evaluation-only ablation: the base model served by the same endpoint (e.g. Qwen/Qwen3-4B-Instruct-2507)
MODEL3_ABLATION_MODEL=
MODEL3_TEMPERATURE=0.2
MODEL3_TIMEOUT_SECONDS=90

# ---------- RAG ----------
RAG_TOP_K=4
RAG_MAX_DISTANCE=0.6
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_NO_EVIDENCE_SHORT_CIRCUIT=true
# CHROMA_PERSIST_DIR defaults to ./storage/chroma ; LOCAL_DOCS_DIR defaults to ./data/sample_docs

# ---------- Google Drive (Phase 3) - see docs/SETUP_DRIVE.md ----------
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_AUTH_MODE=service_account
GOOGLE_DRIVE_CREDENTIALS_FILE=
GOOGLE_DRIVE_TOKEN_FILE=./secrets/drive-token.json
DRIVE_POLL_ENABLED=false
DRIVE_SYNC_INTERVAL_SECONDS=300

# ---------- Database ----------
# DATABASE_URL defaults to sqlite:///<repo>/storage/helpdesk.db

# ---------- Applicant verification (prototype only; production needs SSO) ----------
APPLICANT_SESSION_TTL_MINUTES=30
VERIFY_MAX_ATTEMPTS=5
VERIFY_WINDOW_MINUTES=15

# ---------- Email (simulated by default) - see docs/SETUP_EMAIL.md ----------
EMAIL_PROVIDER=console
EMAIL_SEND_ENABLED=false
EMAIL_FROM=helpdesk-demo@example.com
# Required for real sending: comma-separated addresses or @domains
EMAIL_RECIPIENT_ALLOWLIST=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
NOTIFICATION_COOLDOWN_MINUTES=15
NOTIFICATION_MAX_PER_DAY=3

# ---------- LLMOps ----------
TRACE_INCLUDE_TEXT=false
# Optional (pip install -r backend/requirements-mlops.txt): sqlite:///storage/mlflow.db
MLFLOW_TRACKING_URI=

# ---------- Admin (local development only) ----------
# Admin routes stay disabled until this is set to something other than the placeholder.
ADMIN_API_KEY=change-this-for-local-development

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(npm run *)",
      "Bash(npm install)",
      "Bash(python scripts/check_secrets.py *)",
      "Bash(python scripts/export_graph_diagram.py)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(python scripts/seed_demo_db.py *)",
      "Bash(pip install *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./storage/**)",
      "Bash(cat .env*)",
      "Bash(rm -rf *)"
    ]
  }
}
